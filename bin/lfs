#!/usr/bin/env bash
# BareLinux core LFS/MLFS build-system CLI (engine under active implementation).
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
BLF_ROOT="${BLF_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/barelinux-factory}"
WORKSPACES="$BLF_ROOT/workspaces"

fail() { printf 'lfs: error: %s\n' "$*" >&2; exit 2; }
usage() {
  cat <<'USAGE'
BareLinux Factory (BLF)

Usage:
  lfs enter [DISTRO]          Enter the distro build workspace (isolation not yet implemented)
  lfs init DISTRO             Create a distro project
  lfs doctor                  Check mandatory LFS build-host tools and resources
  lfs DISTRO status           Show project state
  lfs DISTRO configure        Open the distro profile in $EDITOR
  lfs DISTRO build [STAGE]    Plan or run an MLFS stage (default: plan)
  lfs DISTRO export           Export a validated bootable ISO
  lfs help

Project names: 1-32 characters; start with a letter; then letters, digits,
hyphens, or underscores.
USAGE
}
valid_name() {
  [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_-]{0,31}$ ]]
}
project_dir() {
  valid_name "$1" || fail "invalid distro name: $1"
  printf '%s/%s' "$WORKSPACES" "$1"
}
require_project() {
  local dir
  dir="$(project_dir "$1")"
  [[ -d "$dir" && -f "$dir/distro.conf" ]] || fail "project '$1' does not exist; create it with: lfs init $1"
  printf '%s' "$dir"
}
validate_profile() {
  local file="$1" line key value
  local -A seen=()
  [[ -f "$file" ]] || fail "missing distro.conf"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || fail "invalid profile line (expected KEY=VALUE)"
    key="${line%%=*}"; value="${line#*=}"
    [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || fail "invalid profile key: $key"
    [[ -z "${seen[$key]+x}" ]] || fail "duplicate profile key: $key"
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || fail "invalid profile value"
    seen["$key"]=1
  done < "$file"
  for key in DISTRO_NAME DISTRO_ID DISTRO_VERSION TARGET_ARCH BUILD_SYSTEM BUILD_AUTOMATION MLFS_VERSION MLFS_COMMIT JHALFS_COMMIT; do
    [[ -n "${seen[$key]+x}" ]] || fail "profile is missing $key"
  done
  grep -Fxq 'TARGET_ARCH=x86_64' "$file" || fail "this build currently supports TARGET_ARCH=x86_64 only"
  grep -Fxq 'BUILD_SYSTEM=mlfs' "$file" || fail "BareLinux requires the MLFS source-build system"
  grep -Fxq 'BUILD_AUTOMATION=alfs' "$file" || fail "BareLinux requires ALFS/jhalfs automation"
  grep -Fxq 'MLFS_VERSION=13.1' "$file" || fail "BareLinux requires raw MLFS 13.1"
  expected_mlfs="$(awk -F= '$1==\"MLFS_COMMIT\" {print $2}' "$ROOT_DIR/sources/locks/alfs-mlfs.lock")"
  expected_jhalfs="$(awk -F= '$1==\"JHALFS_COMMIT\" {print $2}' "$ROOT_DIR/sources/locks/alfs-mlfs.lock")"
  grep -Fxq "MLFS_COMMIT=$expected_mlfs" "$file" || fail "profile MLFS commit does not match the pinned source lock"
  grep -Fxq "JHALFS_COMMIT=$expected_jhalfs" "$file" || fail "profile jhalfs commit does not match the pinned source lock"
}
[[ $# -ge 1 ]] || { usage; exit 2; }
command="$1"; shift
case "$command" in
  help|-h|--help) usage ;;
  doctor)
    printf 'BareLinux mandatory LFS/MLFS build preflight\n'
    printf 'Host architecture: %s\n' "$(uname -m)"
    printf 'Required target: x86_64\n'
    [[ "$(uname -m)" == x86_64 ]] || printf 'WARNING: host is not x86_64; cross-build support is not implemented.\n'
    required=(bash awk bison bzip2 cc c++ coreutils diff find gawk gcc grep gzip m4 make patch perl python3 sed tar texi2any xz ld as readelf file git curl sha256sum)
    missing=0
    for tool in "${required[@]}"; do
      if command -v "$tool" >/dev/null 2>&1; then
        printf '  [OK]      %s\n' "$tool"
      else
        printf '  [MISSING] %s\n' "$tool"
        missing=$((missing + 1))
      fi
    done
    printf '\nAvailable workspace filesystem space:\n'
    df -h "$BLF_ROOT" 2>/dev/null || df -h "$HOME"
    if (( missing > 0 )); then
      printf '\nMissing %d build prerequisite(s). No build was started.\n' "$missing"
      exit 1
    fi
    printf '\nHost tool preflight passed. This does not mean the LFS toolchain or target system is built.\n'
    ;;
  init)
    [[ $# -eq 1 ]] || fail "usage: lfs init DISTRO"
    name="$1"; dir="$(project_dir "$name")"
    [[ ! -e "$dir" ]] || fail "project already exists: $name"
    mkdir -p "$WORKSPACES"
    mkdir "$dir"
    cat > "$dir/distro.conf" <<PROFILE
# BareLinux Factory distro profile. Edit values, do not source this file.
DISTRO_NAME=$name
DISTRO_ID=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')
DISTRO_VERSION=0.1.0
MLFS_VERSION=13.1
MLFS_COMMIT=$(awk -F= '$1==\"MLFS_COMMIT\" {print $2}' "$ROOT_DIR/sources/locks/alfs-mlfs.lock")
JHALFS_COMMIT=$(awk -F= '$1==\"JHALFS_COMMIT\" {print $2}' "$ROOT_DIR/sources/locks/alfs-mlfs.lock")
TARGET_ARCH=x86_64
CPU_BASELINE=x86-64
LIBC=glibc
INIT_SYSTEM=systemd
BOOTLOADER=limine
FILESYSTEM=btrfs
BUILD_SYSTEM=mlfs
BUILD_AUTOMATION=alfs
PROFILE_VERSION=1
PROFILE
    mkdir -p "$dir"/{sources,build,rootfs,output,logs}
    printf 'Created BLF project: %s\nWorkspace: %s\n' "$name" "$dir"
    printf 'Next: lfs %s configure\n' "$name"
    ;;
  enter)
    [[ $# -le 1 ]] || fail "usage: lfs enter [DISTRO]"
    mkdir -p "$WORKSPACES"
    if [[ $# -eq 1 ]]; then
      dir="$(require_project "$1")"
      export BLF_DISTRO="$1"
    else
      dir="$BLF_ROOT"
      export BLF_DISTRO=""
    fi
    export BLF_ROOT WORKSPACES LFS_WORKSPACE="$dir"
    export PS1="(barelinux-factory:${BLF_DISTRO:-workspace}) ${PS1:-\\u@\\h:\\w\\$ }"
    printf 'Entering BLF workspace shell. Host root is not changed.\nWorkspace: %s\nType exit to leave.\n' "$dir"
    exec "${SHELL:-/bin/bash}" --noprofile --norc -i
    ;;
  *)
    [[ $# -ge 1 ]] || fail "expected a subcommand; run: lfs help"
    name="$command"; sub="$1"; shift
    if [[ "$sub" == build ]]; then
      [[ $# -le 1 ]] || fail "usage: lfs DISTRO build [binutils-pass1]"
    else
      [[ $# -eq 0 ]] || fail "unexpected extra arguments"
    fi
    dir="$(require_project "$name")"
    case "$sub" in
      status)
        validate_profile "$dir/distro.conf"
        printf 'Project: %s\nWorkspace: %s\nProfile: valid\n' "$name" "$dir"
        if [[ -f "$dir/build/mlfs-13.1/binutils-pass1/BUILD-SUCCESS" ]]; then
          printf 'Binutils Pass 1: compiled (stage marker present)\n'
        else
          printf 'Build: not built\n'
        fi
        ;;
      configure)
        validate_profile "$dir/distro.conf"
        editor="${EDITOR:-}"
        [[ -n "$editor" ]] || fail 'EDITOR is not set; set EDITOR to your preferred text editor'
        # Deliberately split editor command into executable and arguments without eval.
        read -r -a editor_cmd <<< "$editor"
        [[ ${#editor_cmd[@]} -gt 0 ]] || fail 'EDITOR is empty'
        "${editor_cmd[@]}" "$dir/distro.conf"
        validate_profile "$dir/distro.conf"
        printf 'Profile validated: %s\n' "$dir/distro.conf"
        ;;
      build)
        validate_profile "$dir/distro.conf"
        stage="${1:-plan}"
        case "$stage" in
          plan)
            cat <<PLAN
BareLinux MLFS 13.1 build plan for $name
  1. binutils-pass1  - bootstrap cross-linker and assembler
  2. gcc-pass1       - ALFS-generated MLFS cross compiler
  3. linux-headers   - target Linux API headers
  4. glibc           - target C library
  5. temporary-tools - remaining MLFS temporary toolchain
  6. full-book       - complete jhalfs-generated MLFS dependency graph
  7. integrate       - BareLinux kernel, systemd policy, MPL/HSR, immutable layout
  8. iso             - Limine BIOS/UEFI image and boot acceptance
PLAN
            printf '\nOnly binutils-pass1 and full-book have build entry points today. Later stages remain gated until their inputs and validators exist.\n'
            ;;
          binutils-pass1)
            bash "$ROOT_DIR/scripts/build-binutils-pass1.sh" "$dir"
            ;;
          full-book)
            build_root="${BLF_MLFS_BUILD_ROOT:-$dir/build/mlfs-13.1/alfs-root}"
            home_archive="${LFS_HOME_ARCHIVE:-$dir/build/mlfs-13.1/lfs-home.tar.xz}"
            [[ -d "$build_root/target/jhalfs" && -s "$build_root/target/build/mlfs-13.1/binutils-pass1/BUILD-SUCCESS" ]] || fail "full-book requires the verified ALFS Binutils checkpoint unpacked at $build_root (expected target/jhalfs and target/build/mlfs-13.1/binutils-pass1/BUILD-SUCCESS)"
            [[ -s "$home_archive" ]] || fail "full-book requires the matching lfs-home.tar.xz at $home_archive; set LFS_HOME_ARCHIVE to its path"
            BLF_BUILD_JOBS="${BLF_BUILD_JOBS:-2}" LFS_HOME_ARCHIVE="$home_archive" bash "$ROOT_DIR/scripts/build-mlfs-full-alfs.sh" "$build_root"
            ;;
          *) fail "unsupported build stage: $stage (available: plan, binutils-pass1, full-book)" ;;
        esac
        ;;
      export)
        validate_profile "$dir/distro.conf"
        fail "ISO export is not ready: no validated MLFS rootfs and boot artifacts exist. No ISO was produced."
        ;;
      *) fail "unknown project action: $sub (run: lfs help)" ;;
    esac
    ;;
esac
