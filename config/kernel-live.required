# BareLinux live ISO kernel requirements
# Every item must be built into the kernel (not =m), because the initramfs
# intentionally does not ship kernel modules.
CONFIG_64BIT
CONFIG_X86_64
CONFIG_BLK_DEV_INITRD
CONFIG_BINFMT_ELF
CONFIG_DEVTMPFS
CONFIG_DEVTMPFS_MOUNT
CONFIG_PROC_FS
CONFIG_SYSFS
CONFIG_TMPFS
CONFIG_OVERLAY_FS
CONFIG_ISO9660_FS
CONFIG_SQUASHFS
CONFIG_SQUASHFS_ZLIB
CONFIG_BLK_DEV_LOOP
CONFIG_ATA
CONFIG_SCSI
CONFIG_BLK_DEV_SD
CONFIG_BLK_DEV_SR
CONFIG_SCSI_CDROM
CONFIG_SATA_AHCI
CONFIG_USB
CONFIG_USB_XHCI_HCD
CONFIG_USB_STORAGE
CONFIG_NVME_CORE
CONFIG_BLK_DEV_NVME
CONFIG_VIRTIO_PCI
CONFIG_VIRTIO_BLK
CONFIG_SERIAL_8250
CONFIG_SERIAL_8250_CONSOLE
